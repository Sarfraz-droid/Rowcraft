      "description": "Schema map object with type and key metadata.",
      "html": "<article class=\"ds-table\"><header><button>customers</button><small>public</small></header><div><span>PK</span> id <small>INTEGER</small></div><footer>1 column \u00b7 1 index</footer></article>",
      "css": ".ds-table{font-family:var(--mono,\"JetBrains Mono\",monospace);font-size:11px;width:260px;border:1px solid var(--border,#303640);border-radius:6px;background:var(--panel,#1d2027);color:var(--text,#dce0e8);overflow:hidden}.ds-table header{display:flex;justify-content:space-between;padding:11px 13px;background:var(--hover,#272e39);border-bottom:1px solid var(--border,#303640)}.ds-table button{font-family:var(--mono,\"JetBrains Mono\",monospace);font-size:11px;font-size:12px;font-weight:600;border:0;background:none;color:inherit;padding:0;cursor:pointer}.ds-table button:hover{color:var(--accent,#85b4f9)}.ds-table button:focus-visible{outline:2px solid var(--accent,#85b4f9);outline-offset:2px}.ds-table small{color:var(--muted,#9aa3b5);font-size:9px}.ds-table>div{display:flex;gap:8px;padding:10px 11px}.ds-table>div small{margin-left:auto}.ds-table>div span{color:var(--accent,#85b4f9);font-size:8px}.ds-table footer{padding:8px 12px;border-top:1px solid var(--border,#303640);color:var(--muted,#9aa3b5);font-size:9px}"
    },
    {
      "name": "Workspace document tab",
      "kind": "nav",
      "description": "An independently closable document; source subtitles appear for cross-source workspaces and tooltips always identify the source.",
      "html": "<div class=\"ds-document\"><button class=\"ds-document-select\" role=\"tab\" aria-selected=\"true\">Console 1 <small>local</small></button><button class=\"ds-document-close\" aria-label=\"Close Console 1 for local\">\u00d7</button></div>",
      "css": ".ds-document{display:inline-flex;height:35px;border-right:1px solid var(--border,#303640);border-bottom:2px solid var(--accent,#85b4f9);background:var(--bg,#17191e);color:var(--text,#dce0e8)}.ds-document button{font-family:var(--mono,\"JetBrains Mono\",monospace);font-size:11px;color:inherit;border:0;background:none;cursor:pointer}.ds-document-select{display:flex;align-items:center;gap:7px;padding:0 3px 0 11px}.ds-document-select small{font-size:8px;color:var(--muted,#9aa3b5)}.ds-document-close{align-self:center;width:24px;height:27px;border-radius:4px}.ds-document button:hover{background:var(--hover,#272e39)}.ds-document button:focus-visible{outline:2px solid var(--accent,#85b4f9);outline-offset:-3px}"
    },
    {
      "name": "Console database selector",
      "kind": "input",
      "description": "Saved source target for the current SQL document.",
      "html": "<label class=\"ds-database\">Database <select aria-label=\"Database for Console 1\"><option>local</option><option>analytics</option></select></label>",
      "css": ".ds-database{font-family:var(--mono,\"JetBrains Mono\",monospace);font-size:11px;display:inline-flex;align-items:center;gap:8px;font-size:10px;color:var(--muted,#9aa3b5)}.ds-database select{font-family:var(--mono,\"JetBrains Mono\",monospace);font-size:11px;background:var(--bg,#17191e);color:var(--text,#dce0e8);border:1px solid var(--border,#303640);padding:3px 23px 3px 7px;border-radius:3px;min-width:100px;max-width:260px}.ds-database select:hover{border-color:var(--muted,#9aa3b5)}.ds-database select:focus-visible{outline:2px solid var(--accent,#85b4f9);outline-offset:1px}"
    }
  ],
  "narrative": {
    "northStar": "Developer workbench",
    "overview": "dglite uses a compact developer workbench: a persistent source navigator, closable documents across sources, and dedicated views for SQL, data, and database structure. Monospace type carries the interface and the data. Quiet graphite or light surfaces keep blue selection and action states easy to find.\n\nThis document records the implemented UI in the desktop frontend. Its descriptive language is inferred from source, rather than a separately approved brand concept. No image comp defines this system. Browser visual verification is pending; these values were extracted from code.",
    "keyCharacteristics": [
      "Compact navigation and toolbars",
      "Self-hosted monospace typography",
      "Theme-aware surfaces and restrained blue actions",
      "Charts and relationships derived from returned data"
    ],
    "rules": [
      {
        "name": "The Context Rule",
        "body": "Use blue for actions, selection, and data marks; pair connection and failure colors with readable state text.",
        "section": "colors"
      },
      {
        "name": "The Data Rule",
        "body": "Keep SQL, object names, numeric values, and surrounding controls in the shared monospace family.",
        "section": "typography"
      },
      {
        "name": "The Overlay Rule",
        "body": "Reserve shadows for menus and dialogs; separate working panes with tone and borders.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared theme variables for surfaces, text, borders, and state.",
      "Do keep source context visible in navigation and workspace breadcrumbs.",
      "Do pair state colors with labels, icons, counts, or key markers.",
      "Do preserve scrolling, truncation, and focus states when adding dense content."
    ],
    "donts": [
      "Don't add large display typography to routine database views.",
      "Don't use shadows to separate ordinary workspace panes.",
      "Don't draw relationships or chart values that the catalog or query result does not supply.",
      "Don't treat session history or SQL drafts as durable storage."
    ]
  }
}
