{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rowcraft",
  "version": "0.0.9",
  "identifier": "dev.rowcraft.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rowcraft",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Rowcraft",
    "category": "DeveloperTool",
    "shortDescription": "A database workbench for SQL and data exploration.",
    "longDescription": "Rowcraft is a desktop database workbench with a SQL editor, schema explorer, result grids, SSH tunnels, and configurable database drivers.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBNzg1MkY0OUEwREU4N0MKUldSODZBMmE5Rko0Q3MxWENnUHl1RW92V3pyVnRxRHVOZnh4c3ZUdGhSbUxJWDlLRVRITFdtWGEK",
      "endpoints": ["https://github.com/Sarfraz-droid/Rowcraft/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
